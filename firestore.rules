rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /photos/{photoId} {
      // Règles complètement ouvertes pour les tests
      allow read, write: if true;
    }
    match /{document=**} {
      // Règles complètement ouvertes pour les tests
      allow read, write: if true;
    }
  }
}
